# MediPass Environment Configuration Example
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secrets for role segregation & anti-spoofing
JWT_PATIENT_SECRET=medipass_patient_jwt_secret_dev_32char_key!
JWT_DOCTOR_SECRET=medipass_doctor_jwt_secret_dev_32char_key!
JWT_GUEST_SECRET=medipass_guest_jwt_secret_dev_32char_key!
JWT_CONSENT_SECRET=medipass_consent_qr_secret_dev_32char_key!

# AI Provider Configuration (mock | openai | gemini | anthropic)
AI_PROVIDER=mock

# Optional real AI provider keys (leave empty to use grounded mockProvider)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Data persistence directory
DATA_DIR=./data
